# Server-only admin authentication. Never prefix these with NEXT_PUBLIC_.
# Supabase US-region PostgreSQL transaction pooler; use a least-privilege runtime role.
DATABASE_URL=
# Owner/migration-role connection; not used by web requests.
DATABASE_MIGRATION_URL=
# Provider CA PEM; Supabase root is in docs/certificates/supabase-root-2021.crt.
# Literal \n escapes are supported. Empty uses system trust, which may not trust Supabase.
DATABASE_CA_CERT=
# Exact origin, no trailing slash. HTTPS is required in production.
AUTH_ORIGIN=
# 32 random bytes encoded as 64 lowercase hex characters.
AUTH_SECRET=
ORGANISATION_NAME=
SUPER_ADMIN_EMAIL=
# Seed only. Local development: password123. Production requires a strong password.
# Remove after initial seed; later runs never overwrite existing accounts.
SUPER_ADMIN_INITIAL_PASSWORD=
# SMTP credentials are independent of the super admin identity.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# A plain email address or a single named sender: Emcrown Staff <staff@example.com>
SMTP_FROM=

# CMS images: private bucket; server-only service role key (never NEXT_PUBLIC).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Clinical encryption: independent of AUTH_SECRET. Keep old keys for reads/rotation.
# JSON map of key IDs to 32-byte hexadecimal keys. Never commit real values.
CLINICAL_ENCRYPTION_KEYS=
CLINICAL_ACTIVE_KEY=
# Separate stable signing/HMAC key; rotation needs a manage-link/suppression migration.
CLINICAL_TOKEN_KEY=
# Separate private CV bucket; encrypted application/octet-stream objects, 5 MB limit.
SUPABASE_CV_BUCKET=
# Explicit operational launch gates. Keep false until provider/privacy approval.
CLINICAL_BOOKING_ENABLED=false
CLINICAL_INTEGRATIONS_APPROVED=false
CLINICAL_RETENTION_DAYS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Approved patient mail transport, independent of authentication SMTP.
CLINICAL_SMTP_HOST=
CLINICAL_SMTP_PORT=
CLINICAL_SMTP_USER=
CLINICAL_SMTP_PASSWORD=
CLINICAL_SMTP_FROM=
CLINICAL_STAFF_EMAIL=
# AWS SES uses the SMTP fields above; see docs/MESSAGING.md.
# Optional SMS: AWS is selected; keep disabled until BAA, verification and testing.
CLINICAL_SMS_ENABLED=false
CLINICAL_SMS_APPROVED=false
CLINICAL_SMS_PROVIDER=aws
AWS_REGION=
# Prefer a workload IAM role; keys below are only for deployments needing credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SMS_ORIGINATION_IDENTITY=
AWS_SMS_CONFIGURATION_SET=
AWS_SMS_PROTECT_CONFIGURATION_ID=
# Explicit USD ceiling per SMS message, including all parts; choose after testing.
AWS_SMS_MAX_PRICE=
# Legacy Twilio only; not required for AWS. Never switch providers with pending sends.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Dedicated local integration tests only; never a real patient database.
AUTH_TEST_DATABASE_URL=
# Optional scheduler endpoint: leave blank to disable HTTP worker access.
# Set a random secret (at least 32 characters) when enabling delivery later.
# External scheduler sends Authorization: Bearer <secret>; never put it in a URL.
CRON_SECRET=

# Optional verified SES delivery/bounce/complaint events. Apply migration 0009 first.
CLINICAL_EMAIL_EVENTS_ENABLED=false
AWS_SES_EVENT_TOPIC_ARN=
